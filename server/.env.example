# ── Hi backend configuration ────────────────────────────────────────────────
# Copy this file to server/.env and fill in the values.

# PostgreSQL (required)
DATABASE_URL=postgres://postgres:hi@localhost:5432/hi

# HTTP port
PORT=8787

# Secrets (required in production; long random strings)
JWT_SECRET=
# Shared token the Python/Agentverse agents must present (WS ?token= / Bearer).
AGENT_TOKEN=

# Remote coding tasks: the agent has no user identity, so pin the account whose
# desktop island should run Claude Code / OpenCode / Antigravity. Leave empty to
# use the only user with a connected desktop (ambiguous -> request refused).
HI_AGENT_USER_ID=

# Desktop side (not the server): allowed workspace roots for remote coding
# tasks, separated by ";" (Windows) or ",". Defaults to the user's home folder.
# HI_CODING_ROOTS=C:\Users\you\code;D:\work

# ASI:ONE by Fetch.ai — https://asi1.ai/dashboard/api-keys
ASI_ONE_API_KEY=
# OpenAI-compatible endpoint (https://docs.asi1.ai).
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
# Verified models: asi1 | asi1-ultra | asi1-mini
ASI_ONE_MODEL=asi1
ASI_ONE_MINI_MODEL=asi1-mini

# Android push (optional): Expo access token for OTA push notifications via
# https://exp.host/--/api/v2/push/send. Leave empty to disable push.
EXPO_ACCESS_TOKEN=

# CORS origins (comma separated), e.g. https://hi.example.com. Desktop uses
# secure IPC, not CORS.
ALLOWED_ORIGINS=

# Logging: info | debug
LOG_LEVEL=info
